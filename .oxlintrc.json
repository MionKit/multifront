{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error"
  },
  "plugins": ["typescript", "oxc", "unicorn", "import"],
  "rules": {
    "no-console": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-empty-object-type": "error",
    "typescript/consistent-type-imports": "error",
    "import/no-cycle": "error"
  },
  "ignorePatterns": ["node_modules/**", "**/dist/**", "**/coverage/**", "**/.tmp/**", "**/__snapshots__/**", "scripts/**", ".claude/**", "docs/**", "packages/e2e/fixtures/apps/rewrite-edges/syntax-error.mjs"],
  "overrides": [
    {
      "files": ["**/*.spec.ts", "**/*.test.ts"],
      "rules": {
        "typescript/no-explicit-any": "off",
        "typescript/no-unused-vars": ["warn", {"args": "none"}]
      }
    },
    {
      "files": [".agents/**/*.mjs"],
      "rules": {"no-console": "off"}
    }
  ]
}
