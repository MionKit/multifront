{
  "name": "@multifront/vite",
  "version": "0.0.0",
  "description": "Vite plugin for multifront component files, built on @vitejs/plugin-vue.",
  "type": "module",
  "license": "MIT",
  "author": "ma-jerez",
  "homepage": "https://github.com/MionKit/multifront#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MionKit/multifront.git",
    "directory": "packages/vite"
  },
  "bugs": {
    "url": "https://github.com/MionKit/multifront/issues"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "imports": {
    "#cli": {
      "source": "./src/library/cli.ts",
      "default": "./dist/library/cli.js"
    }
  },
  "bin": {
    "mf-build": "./bin/mf-build.js"
  },
  "files": [
    "bin",
    "dist",
    "!dist/**/*.tsbuildinfo"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@jridgewell/trace-mapping": "0.3.31",
    "@multifront/core": "workspace:*",
    "generic-names": "4.0.0",
    "magic-string": "1.3.1"
  },
  "peerDependencies": {
    "@multifront/language-tools": "workspace:*",
    "@sveltejs/vite-plugin-svelte": "^7.1.1",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vue/compiler-sfc": "^3.5.15",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "svelte": "^5.55.6",
    "typescript": "^6.0.0",
    "vite": "^8.0.0",
    "vue-tsc": "^3.3.11"
  },
  "peerDependenciesMeta": {
    "@multifront/language-tools": {
      "optional": true
    },
    "@sveltejs/vite-plugin-svelte": {
      "optional": true
    },
    "@vitejs/plugin-react": {
      "optional": true
    },
    "@vitejs/plugin-vue": {
      "optional": true
    },
    "@vue/compiler-sfc": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "typescript": {
      "optional": true
    },
    "vue-tsc": {
      "optional": true
    }
  },
  "devDependencies": {
    "@multifront/language-tools": "workspace:*",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/compiler-sfc": "3.5.42",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "svelte": "5.57.0",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vue": "3.5.42",
    "vue-tsc": "3.3.11"
  }
}
