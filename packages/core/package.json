{
  "name": "@multifront/core",
  "version": "0.0.0",
  "description": "Bundler-agnostic compiler for multifront component files: block splitter, shared styles and per-framework transforms.",
  "type": "module",
  "license": "MIT",
  "author": "ma-jerez",
  "homepage": "https://github.com/MionKit/multifront#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MionKit/multifront.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/MionKit/multifront/issues"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@jridgewell/sourcemap-codec": "1.6.0",
    "magic-string": "1.3.1",
    "oxc-parser": "0.149.0"
  },
  "peerDependencies": {
    "@vue/compiler-sfc": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "@vue/compiler-sfc": {
      "optional": true
    }
  },
  "devDependencies": {
    "@vue/compiler-sfc": "3.5.42"
  }
}
