
  <script lang="ts">
import {__ucfScopeAttrs} from "virtual:multifront/scope-attrs";
    let { label = 'destructure', ...rest }: { label?: string; class?: string; style?: string } = $props()
    const { class: klass, 'style': style } = $derived(rest)
  </script>
  <!-- Destructures both from the rest itself, through `$derived`: neither is merged. -->
  <p {...__ucfScopeAttrs(rest)} class={['own', klass]} {style}>{label}</p>
