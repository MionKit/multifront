import {__frontScopeAttrs, __frontClass} from "virtual:multifront/scope-attrs";

  type Props = { branch?: string }

  export default function Destructured(__props: Props) {const { branch } = __props;
    return <div {...__frontScopeAttrs(__props)} style={__props.style} ref={__props.ref} className={__frontClass("shape", __props.className)}><span className="inner">destructured {branch}</span></div>
  }
