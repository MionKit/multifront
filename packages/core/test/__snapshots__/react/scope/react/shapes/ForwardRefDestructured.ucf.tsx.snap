import {__ucfScopeAttrs} from "virtual:multifront/scope-attrs";

  import { forwardRef } from 'react'

  export default forwardRef<HTMLDivElement, { branch?: string }>((__props, ref) => {const { branch } = __props; return (
    <div {...__ucfScopeAttrs(__props)} ref={ref} className="shape"><span className="inner">forwardRef destructured {branch}</span></div>
  )})
