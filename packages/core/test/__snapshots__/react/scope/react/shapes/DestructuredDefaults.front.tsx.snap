import {__frontScopeAttrs, __frontClass} from "virtual:multifront/scope-attrs";

  type Props = { branch?: string; label?: string; note?: string }

  // Rest is read, not spread: spread on the root, it would carry the scope there itself.
  export default function DestructuredDefaults(__props: Props = {}) {const {
    /* shown without a label */
    label = 'default label',
    branch,
    ...rest
  } = __props;
    return (
      <section {...__frontScopeAttrs(__props)} style={__props.style} ref={__props.ref} className={__frontClass("shape", __props.className)}><span className="inner">{label} / {branch} / {rest.note ?? 'no note'}</span></section>
    )
  }
