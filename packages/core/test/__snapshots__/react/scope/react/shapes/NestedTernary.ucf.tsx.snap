import {__ucfScopeAttrs} from "virtual:multifront/scope-attrs";

  import type { ReactNode } from 'react'

  export default function NestedTernary(props: { branch?: string }) {
    return props.branch === 'a' ? (
      <div {...__ucfScopeAttrs(props)} className="shape"><span className="inner">a</span></div>
    ) : props.branch === 'b' ? (
      <p {...__ucfScopeAttrs(props)} className="shape"><span className="inner">b</span></p>
    ) : (
      <section {...__ucfScopeAttrs(props)} className="shape"><span className="inner">c</span></section> satisfies ReactNode
    )
  }
