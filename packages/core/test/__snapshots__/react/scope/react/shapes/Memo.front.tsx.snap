import {__frontScopeAttrs, __frontClass} from "virtual:multifront/scope-attrs";

  import { memo } from 'react'

  export default memo(function Memo(props: { branch?: string }) {
    return <div {...__frontScopeAttrs(props)} style={props.style} ref={props.ref} className={__frontClass("shape", props.className)}><span className="inner">memo {props.branch}</span></div>
  })
