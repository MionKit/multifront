import {__frontScopeAttrs, __frontClass} from "virtual:multifront/scope-attrs";

  import { forwardRef } from 'react'

  export default forwardRef<HTMLDivElement, { branch?: string }>((__props, ref) => {const { branch } = __props; return (
    <div {...__frontScopeAttrs(__props)} style={__props.style} ref={ref} className={__frontClass("shape", __props.className)}><span className="inner">forwardRef destructured {branch}</span></div>
  )})
