import {__frontScopeAttrs, __frontClass} from "virtual:multifront/scope-attrs";

  type Props = { branch?: string; fallback?: string }

  export default function AndRoot(props: Props) {
    if (props.branch === 'or') return props.fallback || <p {...__frontScopeAttrs(props)} style={props.style} ref={props.ref} className={__frontClass("shape", props.className)}><span className="inner">or</span></p>
    if (props.branch === 'nullish') return props.fallback ?? <section {...__frontScopeAttrs(props)} style={props.style} ref={props.ref} className={__frontClass("shape", props.className)}><span className="inner">nullish</span></section>
    return props.branch === 'and' && <div {...__frontScopeAttrs(props)} style={props.style} ref={props.ref} className={__frontClass("shape", props.className)}><span className="inner">and</span></div>
  }
