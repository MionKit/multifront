import {__frontScopeAttrs} from "virtual:multifront/scope-attrs";

  import { useState } from 'react'

  type Props = { className?: string; onChange?: (value: string) => void }

  // The body's `className` and `value` meet only a plain key and the annotation, which bind nothing: forwarded.
  export default function RenamedKey(__props: Props) {const { className: extra, onChange } = __props;
    const [value, setValue] = useState('')
    const className = `shape ${extra ?? ''}`
    return <div {...__frontScopeAttrs(__props)} style={__props.style} ref={__props.ref} className={className} onClick={() => onChange?.(value)} onDoubleClick={() => setValue('x')}>{value}</div>
  }
