import {__ucfScopeAttrs, __ucfClass} from "virtual:multifront/scope-attrs";

  // A TypeScript `this` parameter comes first; the props are the next one.
  export default function ThisParam(this: void, props: { branch?: string }) {
    return <div {...__ucfScopeAttrs(props)} style={props.style} ref={props.ref} className={__ucfClass("shape", props.className)}><span className="inner">this param {props.branch}</span></div>
  }
