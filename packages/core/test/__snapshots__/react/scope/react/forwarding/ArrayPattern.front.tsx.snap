import {__frontScopeAttrs, __frontClass} from "virtual:multifront/scope-attrs";

  // An array pattern, optional, with a comment holding its closing bracket before the annotation.
  export default function ArrayPattern(__props /* ] */ ?: [string?]) {const [ first ] = __props;
    return <div {...__frontScopeAttrs(__props)} style={__props.style} ref={__props.ref} className={__frontClass("shape", __props.className)}>{first}</div>
  }
