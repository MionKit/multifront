import {__ucfScopeAttrs} from "virtual:multifront/scope-attrs";

  // The directive must stay first in the body, so the props line goes after it.
  export default function DirectiveBody(__props: { branch?: string }) {
    'use no memo'
    const { branch } = __props;return <div {...__ucfScopeAttrs(__props)} className="shape">{branch}</div>
  }
