import {__frontScopeAttrs, __frontClass} from "virtual:multifront/scope-attrs";

  // The block uses `__props` and `__props1`, so the build names the props `__props2`.
  const __props = 'module'
  const __props1 = 'module too'

  export default function PropsClash(__props2: { branch?: string }) {const { branch } = __props2;
    return <div {...__frontScopeAttrs(__props2)} style={__props2.style} ref={__props2.ref} className={__frontClass("shape", __props2.className)}>{__props} {__props1} {branch}</div>
  }
