import {__ucfScopeAttrs, __ucfClass} from "virtual:multifront/scope-attrs";

  type Props = { branch?: string }

  // A default-valued parameter still names every prop.
  function ExportAsDefault(props: Props = {}) {
    return <div {...__ucfScopeAttrs(props)} style={props.style} ref={props.ref} className={__ucfClass("shape", props.className)}><span className="inner">as default {props.branch}</span></div>
  }

  export { ExportAsDefault as default }
