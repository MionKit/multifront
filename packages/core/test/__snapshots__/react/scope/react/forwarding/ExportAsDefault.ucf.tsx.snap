import {__ucfScopeAttrs} from "virtual:multifront/scope-attrs";

  type Props = { branch?: string }

  // A default-valued parameter still names every prop.
  function ExportAsDefault(props: Props = {}) {
    return <div {...__ucfScopeAttrs(props)} className="shape"><span className="inner">as default {props.branch}</span></div>
  }

  export { ExportAsDefault as default }
