import {__frontScopeAttrs, __frontClass} from "virtual:multifront/scope-attrs";

  // The directive must stay first in the body, so the props line goes after it.
  export default function DirectiveBody(__props: { branch?: string }) {
    'use no memo'
    const { branch } = __props;return <div {...__frontScopeAttrs(__props)} style={__props.style} ref={__props.ref} className={__frontClass("shape", __props.className)}>{branch}</div>
  }
