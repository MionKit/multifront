import {__ucfScopeAttrs, __ucfClass, __ucfStyle, __ucfRef} from "virtual:multifront/scope-attrs";

  import { useEffect, useRef } from 'react'

  type Props = { branch?: string; tone?: string }

  // Branch `a`: the root's own className, style and ref are merged with the parent's.
  export default function Own(props: Props) {
    const own = useRef<HTMLElement>(null)
    useEffect(() => {
      if (own.current) own.current.dataset.ownRef = own.current.tagName
    }, [])
    if (props.branch === 'a') return <section {...__ucfScopeAttrs(props)} ref={__ucfRef(own, props.ref)} className={__ucfClass("own", props.className)} style={__ucfStyle({ padding: 4 }, props.style)}>own</section>
    return <p {...__ucfScopeAttrs(props)} style={props.style} ref={props.ref} className={__ucfClass(`own-${props.tone ?? 'plain'}`, props.className)}>own</p>
  }
