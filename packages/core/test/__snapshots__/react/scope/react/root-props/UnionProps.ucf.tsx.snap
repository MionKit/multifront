import {__ucfScopeAttrs, __ucfClass} from "virtual:multifront/scope-attrs";

  // A union props type: the root props join every member, not only the last.
  export default function UnionProps(props: { kind: 'a' } | { kind: 'b'; note: string }) {
    return <div {...__ucfScopeAttrs(props)} style={props.style} ref={props.ref} className={__ucfClass("union", props.className)}>{props.kind === 'b' ? props.note : props.kind}</div>
  }
