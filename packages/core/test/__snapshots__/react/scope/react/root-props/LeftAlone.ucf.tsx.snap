import {__ucfScopeAttrs, __ucfClass} from "virtual:multifront/scope-attrs";

  type Props = { branch?: string; tone?: string }

  // Several own `className`: the last one is merged. A string `style` or `ref` is no value React takes: left as written.
  export default function LeftAlone(props: Props) {
    if (props.branch === 'twice')
      // @ts-expect-error Two `className` attributes, on purpose.
      return <div {...__ucfScopeAttrs(props)} style={props.style} ref={props.ref} className="first" className={__ucfClass(props.tone, props.className)}>twice</div>
    if (props.branch === 'braced')
      // @ts-expect-error A string style and ref, on purpose.
      return <p {...__ucfScopeAttrs(props)} className={props.className} style={'color: red'} ref={'braced'}>braced</p>
    // @ts-expect-error A string style and ref, on purpose.
    return <section {...__ucfScopeAttrs(props)} className={props.className} style="color: red" ref="plain">plain</section>
  }
