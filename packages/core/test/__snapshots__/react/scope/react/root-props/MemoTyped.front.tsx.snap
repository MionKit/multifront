import {__frontScopeAttrs, __frontClass} from "virtual:multifront/scope-attrs";

  import { memo } from 'react'

  // An explicit `memo` type argument decides the export's props: the root props go there.
  export default memo<{ branch?: string }>(function MemoTyped(props) {
    return <div {...__frontScopeAttrs(props)} style={props.style} ref={props.ref} className={__frontClass("memo-typed", props.className)}>{props.branch}</div>
  })
