import {__frontScopeAttrs, __frontClass} from "virtual:multifront/scope-attrs";

  type Props = { items: { label: string; className?: string }[] }

  // The inner `props` is an item, not the component's props: the list still merges the parent's className.
  export default function NestedProps(props: Props) {
    return <ul {...__frontScopeAttrs(props)} style={props.style} ref={props.ref} className={__frontClass("list", props.className)}>{props.items.map((props) => <li key={props.label} className={props.className}>{props.label}</li>)}</ul>
  }
