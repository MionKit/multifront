
  'use client';
import "<fixtures>/components/react/UseClient.ucf?ucf&type=style&index=0&lang.css";
import $style from "<fixtures>/components/react/UseClient.ucf?ucf&type=style&index=0&module&lang.js";

  import { useState } from 'react';

  export default function UseClient() {
    const [count, setCount] = useState(0);
    return (
      <button className={$style.button} onClick={() => setCount(count + 1)}>
        Clicked {count}
      </button>
    );
