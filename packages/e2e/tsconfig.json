{
  // Check only: the package is never built. Fixture apps are checked by their own builds, not here.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": ["build", "browser", "editor", "consumer", "devx", "fixtures/index.ts", "*.config.ts"],
  // File snapshots keep the generated code as is: a .tsx one is not a source file of this package.
  "exclude": ["**/__snapshots__"]
}
