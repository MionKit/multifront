{
  "compilerOptions": {
    "target": "es2022",
    // `with { framework }` in mountVue.ts needs it (else TS2823).
    "module": "preserve",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
