<vue>
  <script setup lang="ts">
  // Imported only here, and used only in the template: TypeScript stripping alone would drop it.
  import { TraceMap } from '@jridgewell/trace-mapping'
  </script>

  <template>
    <span>{{ typeof TraceMap }}</span>
  </template>
</vue>

<react>
  import { useEffect, useRef } from 'react'
  import { createRoot } from 'react-dom/client'

  // react-dom/client is imported only here: the dependency scan finds it in this block or not at all.
  export default function Mount() {
    const host = useRef<HTMLDivElement>(null)
    useEffect(() => {
      const inner = createRoot(host.current!)
      inner.render(<span>mounted</span>)
      return () => inner.unmount()
    }, [])
    return <div ref={host} />
  }
</react>
