{
  // mf-lint's tests lint copies of Lint.front and Clean.front under it, mf-fmt's Messy.front left out; it also lints this app's .ts files.
  "rules": {
    "no-debugger": "error",
    "no-undef": "error"
  },
  "overrides": [{"files": ["**/*.tsx"], "rules": {"no-debugger": "warn"}}],
  "ignorePatterns": ["old/**", "Messy.front"]
}
