{
  // Messy.front type-checks in every target before and after mf-fmt formats a copy.
  "compilerOptions": {
    "target": "es2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "plugins": [{"name": "@multifront/language-tools/typescript-plugin", "framework": "react"}]
  },
  "include": ["Messy.front", "react.ts", "vue.ts", "svelte.ts"]
}
