{
  // The parity tests compare mf-fmt with the oxfmt CLI under this config; mf-lint's fixtures stay out of them.
  "singleQuote": true,
  "semi": false,
  "overrides": [
    {"files": ["*.vue"], "options": {"semi": true}},
    {"files": ["*.tsx"], "excludeFiles": ["*.react.tsx"], "options": {"semi": true}},
    {"files": ["./Messy.ucf.style.scss"], "options": {"tabWidth": 2}},
    {"files": ["nested/*.vue"], "options": {"printWidth": 40}}
  ],
  "ignorePatterns": ["old/**", "Lint.ucf", "Clean.ucf"]
}
