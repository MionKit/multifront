<svelte lang="html">
  <script lang="ts">
    import EachRoot from '../../components/svelte/roots/EachRoot.front'
    import EmptyPropsRoot from '../../components/svelte/roots/EmptyPropsRoot.front'
    import EmptyScriptRoot from '../../components/svelte/roots/EmptyScriptRoot.front'
    import EscapedRoot from '../../components/svelte/roots/EscapedRoot.front'
    import HelperClashRoot from '../../components/svelte/roots/HelperClashRoot.front'
    import IfElseRoot from '../../components/svelte/roots/IfElseRoot.front'
    import LegacyRoot from '../../components/svelte/roots/LegacyRoot.front'
    import LegacyStoreRoot from '../../components/svelte/roots/LegacyStoreRoot.front'
    import MultiRoot from '../../components/svelte/roots/MultiRoot.front'
    import NestedRoot from '../../components/svelte/roots/NestedRoot.front'
    import NoPropsRoot from '../../components/svelte/roots/NoPropsRoot.front'
    import OptionsRoot from '../../components/svelte/roots/OptionsRoot.front'
    import PassOnRoot from '../../components/svelte/roots/PassOnRoot.front'
    import PropsOnlyRoot from '../../components/svelte/roots/PropsOnlyRoot.front'
    import RestRoot from '../../components/svelte/roots/RestRoot.front'
    import ShadowRoot from '../../components/svelte/roots/ShadowRoot.front'
    import StoreDerivedRoot from '../../components/svelte/roots/StoreDerivedRoot.front'
    import SvelteElementRoot from '../../components/svelte/roots/SvelteElementRoot.front'
    import TextRoot from '../../components/svelte/roots/TextRoot.front'
    import WarnClashRoot from '../../components/svelte/roots/WarnClashRoot.front'
  </script>

  <!-- Each root shape once per branch; `data-case` names the shape and branch the test reads. StringHandlerRoot
       does not compile, by design. -->
  <main class="parent">
    <div data-case="IfElseRoot:a"><IfElseRoot branch="a" /></div>
    <div data-case="IfElseRoot:b"><IfElseRoot branch="b" /></div>
    <div data-case="IfElseRoot:c"><IfElseRoot branch="c" /></div>
    <div data-case="PassOnRoot:only"><PassOnRoot /></div>
    <div data-case="SvelteElementRoot:only"><SvelteElementRoot tag="aside" /></div>
    <div data-case="NestedRoot:then"><NestedRoot value="resolved" /></div>
    <div data-case="NestedRoot:catch"><NestedRoot fail /></div>
    <div data-case="NestedRoot:failed"><NestedRoot boom /></div>
    <div data-case="RestRoot:only"><RestRoot label="given" note="rest note" /></div>
    <div data-case="NoPropsRoot:only"><NoPropsRoot /></div>
    <div data-case="EscapedRoot:only"><EscapedRoot /></div>
    <div data-case="EmptyPropsRoot:only"><EmptyPropsRoot /></div>
    <div data-case="EmptyScriptRoot:only"><EmptyScriptRoot /></div>
    <div data-case="OptionsRoot:only"><OptionsRoot /></div>
    <div data-case="PropsOnlyRoot:only"><PropsOnlyRoot label="props" /></div>
    <div data-case="ShadowRoot:only"><ShadowRoot /></div>
    <div data-case="StoreDerivedRoot:only"><StoreDerivedRoot /></div>
    <div data-case="HelperClashRoot:only"><HelperClashRoot /></div>
    <div data-case="TextRoot:only"><TextRoot /></div>
    <div data-case="EachRoot:only"><EachRoot /></div>
    <div data-case="MultiRoot:only"><MultiRoot /></div>
    <div data-case="LegacyRoot:only"><LegacyRoot /></div>
    <div data-case="LegacyStoreRoot:only"><LegacyStoreRoot /></div>
    <div data-case="WarnClashRoot:only"><WarnClashRoot /></div>
  </main>
</svelte>

<style scoped>
.shape {
  color: rgb(200, 40, 80);
}
</style>
