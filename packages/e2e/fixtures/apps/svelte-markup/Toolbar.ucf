<svelte>
  <script lang="ts">
    let { title, items = [], load }: { title: string; items?: string[]; load?: Promise<string> } = $props()
    let query = $state('')
  </script>
  <div class={$style.toolbar}>
    <h2>{title}</h2>
    <input type="search" bind:value={query} />
    {#if items.length > 0}
      <ul>
        {#each items as item}
          <li>{item}</li>
        {/each}
      </ul>
    {/if}
    {#await load}
      <p>Loading</p>
    {:then text}
      <p>{text}</p>
    {/await}
  </div>
</svelte>

<style module>
.toolbar { display: flex; gap: 0.5rem; }
</style>
