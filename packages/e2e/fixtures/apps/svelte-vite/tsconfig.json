{
  "compilerOptions": {
    "target": "es2022",
    // `with { framework }` in main.ts needs it (else TS2823).
    "module": "preserve",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    // Its `.front` files sit beside the app, under `components/`; an app with them in `src` uses `./src` here.
    "rootDirs": ["../..", "../../.front/svelte"]
  },
  "include": ["src"]
}
