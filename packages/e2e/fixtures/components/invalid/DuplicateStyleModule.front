<style module>
.first {
  color: gold;
}
</style>

<style module="classes">
.second {
  color: tan;
}
</style>

<style module>
.third {
  color: khaki;
}
</style>

<style module="">
.fourth {
  color: wheat;
}
</style>

<style module="$style">
.fifth {
  color: beige;
}
</style>

<react lang="tsx">
  export default function DuplicateStyleModule() {
    return <p className={`${$style.first} ${classes.second}`}>Duplicate style module</p>
  }
</react>
