<svelte lang="html">
  <script lang="ts">
    import Button from '../Button.ucf'

    const decoy = '<style>'
    const big = { label: 'big' }
    const small = { label: 'small' }
    let count = $state(0)
  </script>
  <svelte:head>
    <style>.head { color: gray; }</style>
  </svelte:head>
  <button class="inside" onclick={() => count > 1 ? (count = 0) : count++}>{decoy}</button>
  <Button label={count > 1 ? 'many' : 'few'} />
  <Button {...(count > 1 ? big : small)} />
  <input value={'{'}>
  <br>
  <style>
  .inside {
    color: crimson;
  }
  </style>
</svelte>

<style>
.inside {
  margin: 0;
}
</style>
