<!-- A module the editor cannot read: no less installed, so it is typed loosely. -->

<style module lang="less">
@pad: 1rem;
.note { padding: @pad; }
</style>

<react lang="tsx">
  export default function LessModule({ label }: { label: string }) {
    return <p className={$style.note}>{label}</p>
  }
</react>
