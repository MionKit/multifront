<!-- CSS module keys the editor must find as the build does: nesting, :global, keyframes, @value, :export, sass. -->

<react>
  export default function StyleModuleEdges({ label }: { label: string }) {
    return (
      <section className={`${$style.card} ${$style.card__body} ${$style['card-title']}`}>
        <p className={`${theme['fade-in']} ${$style.wide}`}>{label}</p>
      </section>
    )
  }
</react>

<style module lang="scss">
// .wide in a line comment is no jump target
/* nor .wide in a block comment */
.card {
  &__body {
    padding: 1rem;
  }

  &::before {
    content: ".wide {";
  }

  &-title,
  .card-title {
    margin: 0;
  }

  :global(.outside) .inner {
    color: red;
  }

  :not(.muted) {
    opacity: 1;
  }
}

@media (min-width: 40em) {
  .wide {
    width: 100%;
  }
}

.dot\.ted {
  color: red;
}

.dot.ted {
  color: blue;
}
</style>

<style module="theme">
@value accent: rebeccapurple;
@value gap 1rem;
@value (x, y as z) from './values.css';

@keyframes fade {
  from {
    opacity: 0;
  }
}

@-webkit-keyframes slide {
  from {
    opacity: 0;
  }
}

@keyframes :local(pop) {
  from {
    opacity: 0;
  }
}

@keyframes :global(spin) {
  to {
    transform: rotate(1turn);
  }
}

:global .page .global-only {
  color: red;
}

.fade-in {
  animation: fade 1s;
  color: accent;
}

:export {
  primary: red;
}
</style>

<style module="rows" lang="sass">
.row
  display: flex
  &__cell
    padding: 0
.row-end
  margin: 0
</style>

<style module="my-theme">
.unreachable {
  color: red;
}
</style>
