<vue lang="vue">
  <script setup lang="ts">
  withDefaults(defineProps<{ tone?: string }>(), { tone: 'calm' })
  </script>

  <template>
    <p :class="['note', tone]" style="margin: 2px; padding: 1px">note</p>
  </template>
</vue>

<svelte lang="html">
  <script lang="ts">
    let { tone = 'calm' }: { tone?: string } = $props()
  </script>

  <p class="note {tone}" style="margin: 2px; padding: 1px">note</p>
</svelte>

<style scoped>
.note {
  font-style: italic;
}
.calm {
  color: rgb(40, 90, 160);
}
</style>

<react lang="tsx">
  export default function Note({ tone = 'calm' }: { tone?: string }) {
    return <p className={`note ${tone}`} style={{ margin: 2, padding: 1 }}>note</p>
  }
</react>
