<svelte lang="html">
  <script lang="ts">
    // Named like the class merge: the build imports it under another name.
    const __frontClass = 'own-merge'
    const style = 'padding: 2px'
    let { branch, tone = 'calm' }: { branch: string; tone?: string } = $props()
  </script>
  {#if branch === 'text'}
    <section class="own &#x74;ext" style="padding: 4px;">text</section>
  {:else if branch === 'mixed'}
    <p class="own {tone}" style="margin: {tone === 'calm' ? 1 : 2}px">mixed</p>
  {:else if branch === 'expression'}
    <div class={['own', tone]} {style}>{__frontClass}</div>
  {:else if branch === 'escaped'}
    <!-- A backslash, backticks and `${` (an entity: `{` opens a tag) stay as written in the merged template. -->
    <p class="a\b `c` $&#123;d {tone}">escaped</p>
  {:else}
    <span class=own-{tone} style:color="blue">directive</span>
  {/if}
</svelte>
