<svelte>
  <script lang="ts">
    let { branch /* the case */, }: { branch: string } = $props()
  </script>
  {#if branch === 'a'}
    {@const label = 'a'}
    <div class="shape"><span class="inner">{label}</span></div>
  {:else if branch === 'b'}
    <p class="shape"><span class="inner">b</span></p>
  {:else}
    <section class="shape"><span class="inner">c</span></section>
  {/if}
</svelte>

<style scoped>
.inner {
  font-style: italic;
}
</style>
