<vue lang="vue">
  <script setup lang="ts">
  import { ref } from 'vue'

  const props = defineProps<{start?: number}>()
  const count = ref(props.start ?? 0)
  </script>

  <template>
    <div class="counter">
      <span class="label">Clicks</span>
      <button :class="$style.button" title="Zähler 𝄞" @click="count++">{{ count }}</button>
    </div>
  </template>
</vue>

<svelte lang="html">
  <script lang="ts">
  import { untrack } from 'svelte'

  let { start = 0 }: { start?: number } = $props()
  let count = $state(untrack(() => start))
  </script>

  <div class="counter">
    <span class="label">Clicks</span>
    <button class={$style.button} title="Zähler 𝄞" onclick={() => count++}>{count}</button>
  </div>
</svelte>

<style scoped>
.counter {
  color: rgb(120, 40, 160);
}
</style>

<style module>
.button {
  padding: 4px 12px;
}
</style>

<react lang="tsx">
  import { useState } from 'react'

  export default function Counter({start = 0}: {start?: number}) {
    const [count, setCount] = useState(start)
    return (
      <div className="counter">
        <span className="label">Clicks</span>
        <button className={$style.button} title="Zähler 𝄞" onClick={() => setCount(count + 1)}>{count}</button>
      </div>
    )
  }
</react>
