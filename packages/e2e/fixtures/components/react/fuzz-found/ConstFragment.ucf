<react>
  import { Fragment } from 'react'

  // Found by the scope fuzz: a fragment held in a const warns only when a return names it, and only when it is the whole value.
  export default function ConstFragment(props: { branch?: string }) {
    const mixed = props.branch === 'mixed' ? (<Fragment><p className="shape">mixed</p><p>second</p></Fragment>) : 'text'
    const content = (
      <>
        <p className="shape">content</p>
        <p>second</p>
      </>
    )
    if (props.branch === 'mixed') return mixed
    if (props.branch === 'content') return content
    return <div className="shape"><span className="inner">element</span></div>
  }
</react>

<style scoped>
.inner {
  font-style: italic;
}
</style>
