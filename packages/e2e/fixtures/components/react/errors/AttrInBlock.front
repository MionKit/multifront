<react lang="tsx">
  import Card from '../../Card.front'
  import Badge from '../../Badge.front' with { framework: 'vue' }
  import Button from '../../Button.front' with { type: 'component', "framework": 'react' }
  export { default as Panel } from '../../Panel.front' with { framework: 'svelte' }
  export * from '../../Hello.front' with { framework: 'vue' }
  import '../../tag-base.css' with { framework: 'vue' }

  const pick = () => 'vue'
  const framework = 'vue'
  const options = { with: { framework: 'vue' } }
  export const lazyCard = import('../../Card.front', { with: { framework: 'vue' } })
  export const lazyBadge = import(`../../Badge.front`, { with: { 'framework': pick() } })
  export const lazyButton = import('../../Button.front', { with: { framework } })
  // Options no one can read statically: no error.
  export const fromVariable = import('../../Card.front', options)
  export const fromSpread = import('../../Card.front', { ...options })
  export const fromComputed = import('../../Card.front', { ['with']: { framework: 'vue' } })

  export default function AttrInBlock() {
    return <><Card title="Hello" /><Badge label="New" /><Button /></>
  }
</react>
