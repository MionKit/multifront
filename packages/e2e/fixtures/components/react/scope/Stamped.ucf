<react>
  import { Fragment, Fragment as Frag } from 'react'
  import * as React from 'react'
  import type { ReactNode } from 'react'

  const ITEMS = ['one', 'two']
  const identity = <T,>(value: T) => value

  const Foo = { Bar: ({ children }: { children: ReactNode }) => <b className="member">{children}</b> }
  // Not React's Fragment: a component like any other.
  const Ui = { Fragment: ({ children }: { children: ReactNode }) => <em className="lookalike">{children}</em> }

  function List<Item extends string>({ items }: { items: Item[] }) {
    return <ol className="list">{items.map((item) => <li key={item}>{item}</li>)}</ol>
  }

  export default function Stamped() {
    const count = 1
    const limit = 2
    const less = count < limit
    // Each named fragment is a sole child once: only there does React check Fragment props on mount.
    return (
      <>
        <div className="box">
          <p className="text">{identity(String(less))}</p>
          <svg className="icon" width="10" height="10">
            <circle className="dot" cx="5" cy="5" r="4" />
          </svg>
          <my-el class="custom">custom</my-el>
          <Foo.Bar>member</Foo.Bar>
          <Ui.Fragment>lookalike</Ui.Fragment>
          <List<string> items={ITEMS} />
          <ul>
            {ITEMS.map((item) => (
              <Fragment key={item}>
                <li className="item">{item}</li>
              </Fragment>
            ))}
          </ul>
          <p className="direct"><Fragment><span>direct</span></Fragment></p>
          <p className="alias"><Frag><span>alias</span></Frag></p>
          <p className="namespace"><React.Fragment><span>namespace</span></React.Fragment></p>
        </div>
      </>
    )
  }
</react>

<style scoped>
.box {
  color: rgb(10, 20, 30);
}
.dot {
  fill: rgb(40, 50, 60);
}
my-el {
  color: rgb(70, 80, 90);
}
.item {
  color: rgb(100, 110, 120);
}
.member {
  color: rgb(130, 140, 150);
}
.lookalike {
  color: rgb(160, 170, 180);
}
.list {
  color: rgb(190, 200, 210);
}
</style>
