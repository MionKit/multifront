<react lang="tsx">
  import { Fragment } from 'react'

  export default function FragmentRoot(props: { branch?: string }) {
    if (props.branch === 'short')
      return (
        <>
          <p className="shape"><span className="inner">short</span></p>
          <p>second</p>
        </>
      )
    return (
      <Fragment>
        <p className="shape"><span className="inner">named</span></p>
        <p>second</p>
      </Fragment>
    )
  }
</react>
