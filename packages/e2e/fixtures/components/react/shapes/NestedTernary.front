<react lang="tsx">
  import type { ReactNode } from 'react'

  export default function NestedTernary(props: { branch?: string }) {
    return props.branch === 'a' ? (
      <div className="shape"><span className="inner">a</span></div>
    ) : props.branch === 'b' ? (
      <p className="shape"><span className="inner">b</span></p>
    ) : (
      <section className="shape"><span className="inner">c</span></section> satisfies ReactNode
    )
  }
</react>
