<react lang="tsx">
  type Props = { branch?: string; label?: string; note?: string }

  // Rest is read, not spread: spread on the root, it would carry the scope there itself.
  export default function DestructuredDefaults({
    /* shown without a label */
    label = 'default label',
    branch,
    ...rest
  }: Props = {}) {
    return (
      <section className="shape"><span className="inner">{label} / {branch} / {rest.note ?? 'no note'}</span></section>
    )
  }
</react>
