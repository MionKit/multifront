{
  "name": "multifront-vscode",
  "displayName": "multifront",
  "version": "0.0.0",
  "description": "VS Code extension for multifront component files: the .ucf grammar, the language server and the TypeScript plugin.",
  "private": true,
  "publisher": "mionkit",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MionKit/multifront.git",
    "directory": "packages/vscode"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "icon": "assets/icon.png",
  "categories": ["Programming Languages", "Formatters", "Linters"],
  "main": "./dist/extension.cjs",
  "exports": {
    "./grammar": {
      "source": "./src/grammar.ts"
    }
  },
  "files": [
    "dist",
    "node_modules/multifront-typescript-plugin-pack",
    "syntaxes/vendor/*/LICENSE",
    "syntaxes/vendor/sources.json",
    "icons",
    "assets/icon.png",
    "language-configuration.json",
    "README.md",
    "LICENSE"
  ],
  "activationEvents": ["onLanguage:ucf"],
  "contributes": {
    "languages": [
      {
        "id": "ucf",
        "aliases": ["UCF", "ucf"],
        "extensions": [".ucf"],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/ucf.svg",
          "dark": "./icons/ucf.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "ucf",
        "scopeName": "source.ucf",
        "path": "./dist/syntaxes/source.ucf.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.style": "css",
          "meta.embedded.block.style.scss": "scss",
          "meta.embedded.block.style.sass": "sass",
          "meta.embedded.block.style.less": "less",
          "meta.embedded.block.style.stylus": "stylus",
          "meta.embedded.block.style.postcss": "postcss",
          "meta.embedded.block.vue": "vue",
          "meta.embedded.block.react": "typescriptreact",
          "meta.embedded.block.svelte": "svelte"
        }
      },
      {
        "scopeName": "source.ucf.vue",
        "path": "./dist/syntaxes/source.ucf.vue.tmLanguage.json"
      },
      {
        "scopeName": "source.ucf.vue.vue.directives",
        "path": "./dist/syntaxes/source.ucf.vue.vue.directives.tmLanguage.json",
        "injectTo": ["source.ucf"]
      },
      {
        "scopeName": "source.ucf.vue.vue.interpolations",
        "path": "./dist/syntaxes/source.ucf.vue.vue.interpolations.tmLanguage.json",
        "injectTo": ["source.ucf"]
      },
      {
        "scopeName": "source.ucf.vue.vue.sfc.script.leading-operator-fix",
        "path": "./dist/syntaxes/source.ucf.vue.vue.sfc.script.leading-operator-fix.tmLanguage.json",
        "injectTo": ["source.ucf"]
      },
      {
        "scopeName": "source.ucf.vue.vue.sfc.style.variable.injection",
        "path": "./dist/syntaxes/source.ucf.vue.vue.sfc.style.variable.injection.tmLanguage.json",
        "injectTo": ["source.ucf"]
      },
      {
        "scopeName": "source.ucf.svelte",
        "path": "./dist/syntaxes/source.ucf.svelte.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "[ucf]": {
        "editor.defaultFormatter": "mionkit.multifront-vscode"
      }
    },
    "typescriptServerPlugins": [
      {
        "name": "multifront-typescript-plugin-pack",
        "enableForWorkspaceTypeScriptVersions": true,
        "languages": ["ucf"]
      }
    ]
  },
  "dependencies": {
    "@multifront/core": "workspace:*",
    "@multifront/language-tools": "workspace:*",
    "@oxc-parser/binding-wasm32-wasi": "0.149.0",
    "@volar/vscode": "2.4.28",
    "vscode-languageclient": "9.0.1"
  }
}
