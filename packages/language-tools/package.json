{
  "name": "@multifront/language-tools",
  "version": "0.0.0",
  "description": "Editor tooling for multifront component files: the Volar language plugin behind the TypeScript plugin and the language server.",
  "type": "module",
  "license": "MIT",
  "author": "ma-jerez",
  "homepage": "https://github.com/MionKit/multifront#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MionKit/multifront.git",
    "directory": "packages/language-tools"
  },
  "bugs": {
    "url": "https://github.com/MionKit/multifront/issues"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "source": "./src/server.ts",
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./typescript-plugin": {
      "source": "./src/typescriptPlugin.ts",
      "types": "./dist/typescriptPlugin.d.ts",
      "default": "./dist/typescriptPlugin.js"
    }
  },
  "bin": {
    "multifront-language-server": "./bin/multifront-language-server.js"
  },
  "files": [
    "bin",
    "dist",
    "typescript-plugin",
    "!dist/**/*.tsbuildinfo"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@multifront/core": "workspace:*",
    "@volar/language-core": "2.4.28",
    "@volar/language-server": "2.4.28",
    "@volar/language-service": "2.4.28",
    "@volar/typescript": "2.4.28",
    "@vue/language-core": "3.3.11",
    "@vue/language-service": "3.3.11",
    "@vue/typescript-plugin": "3.3.11",
    "postcss": "8.5.28",
    "postcss-selector-parser": "7.1.6",
    "svelte2tsx": "0.7.61",
    "volar-service-css": "0.0.71",
    "vscode-uri": "3.2.0"
  },
  "peerDependencies": {
    "@vue/compiler-sfc": "^3.5.15",
    "svelte": "^5.55.6",
    "typescript": "^6.0.0"
  },
  "peerDependenciesMeta": {
    "@vue/compiler-sfc": {
      "optional": true
    },
    "svelte": {
      "optional": true
    }
  },
  "devDependencies": {
    "@vue/compiler-sfc": "3.5.42",
    "svelte": "5.57.0",
    "typescript": "6.0.3"
  }
}
