# Chromium the browser tests (packages/e2e/browser/) and `pnpm devx docs-images` use, when the Playwright one is not installed.
# MULTIFRONT_CHROMIUM_PATH=/opt/pw-browsers/chromium

# Base seed of the fuzz tests. A failing fuzz test prints the seed and run count that replay it.
# MULTIFRONT_FUZZ_SEED=2026
# Inputs per fuzz test (default 500 for the splitter, 300 for the scope transform and the Svelte scope stamping). Raise it for a longer run.
# MULTIFRONT_FUZZ_RUNS=500
