# Browser `pnpm devx docs-images` renders with, when the Playwright one is not installed.
# MULTIFRONT_CHROMIUM_PATH=/opt/pw-browsers/chromium

# Base seed of the fuzz tests. A failing fuzz test prints the seed and run count that replay it.
# MULTIFRONT_FUZZ_SEED=2026
# Inputs per fuzz test. Raise it for a longer run.
# MULTIFRONT_FUZZ_RUNS=500
