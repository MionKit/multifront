{
  "name": "multifront-monorepo",
  "version": "0.0.0",
  "description": "One component file, three frameworks: Vue, React and Svelte implementations with shared styles, compiled to one package per framework.",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "homepage": "https://github.com/MionKit/multifront#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MionKit/multifront.git"
  },
  "bugs": {
    "url": "https://github.com/MionKit/multifront/issues"
  },
  "license": "MIT",
  "author": "ma-jerez",
  "engines": {
    "node": ">= 26.0.0",
    "pnpm": ">= 11.0.0"
  },
  "scripts": {
    "preinstall": "node -e \"if (!(process.env.npm_config_user_agent||'').startsWith('pnpm')) { console.error('\\n\\u274c  Use pnpm, not npm/yarn -- see SETUP.md.\\n'); process.exit(1); }\"",
    "devx": "node scripts/devx.mjs",
    "build": "node scripts/devx.mjs build",
    "test": "node scripts/devx.mjs test",
    "lint": "node scripts/devx.mjs lint",
    "typecheck": "node scripts/devx.mjs typecheck",
    "format": "node scripts/devx.mjs format",
    "check-format": "node scripts/devx.mjs format --check",
    "check": "node scripts/devx.mjs check",
    "clean": "node scripts/devx.mjs clean",
    "prepare": "husky"
  },
  "lint-staged": {
    "packages/**/*.ts": [
      "oxfmt --check --no-error-on-unmatched-pattern",
      "oxlint --no-error-on-unmatched-pattern"
    ],
    "packages/**/*.md": [
      "oxfmt --check --no-error-on-unmatched-pattern"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@jridgewell/trace-mapping": "0.3.31",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@vitejs/plugin-vue": "6.0.8",
    "@vitest/coverage-v8": "5.0.0",
    "@volar/language-core": "2.4.28",
    "@volar/test-utils": "2.4.28",
    "@vscode/vsce": "3.9.2",
    "husky": "9.1.7",
    "lint-staged": "17.5.0",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "playwright": "1.63.0",
    "react": "19.3.0",
    "sass": "1.104.0",
    "shiki": "4.4.3",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "5.0.0",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.3.2",
    "vue": "3.5.42"
  }
}
